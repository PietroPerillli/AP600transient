  owl:onProperty :hasComponent;
  owl:allValuesFrom :PrimaryLoop .

_:node24 a owl:Restriction;
  owl:onProperty :hasComponent;
  owl:allValuesFrom :SecondaryLoop .

_:node25 a owl:Restriction;
  owl:onProperty :isComponentOf;
  owl:allValuesFrom :PWR .

_:node26 a owl:Restriction;
  owl:onProperty :hasComponent;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :RCS .

_:node27 a owl:Restriction;
  owl:onProperty :hasComponent;
  owl:someValuesFrom :ColdLeg .

_:node28 a owl:Restriction;
  owl:onProperty :hasComponent;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Vessel .

_:node29 a owl:Restriction;
  owl:onProperty :isComponentOf;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :PrimaryLoop .

_:node30 a owl:Restriction;
  owl:onProperty :isComponentOf;
  owl:allValuesFrom :PWR .

_:node31 a owl:Restriction;
  owl:onProperty :hasComponent;
  owl:onClass :Turbine;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger .

_:node32 a owl:Restriction;
  owl:onProperty :isConnectedWith;
  owl:someValuesFrom :ElectricGenerator .

