@prefix : <http://www.ap600.com/ontolgies/ap600.owl/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ap600.com/ontolgies/ap600.owl/> .

<http://www.ap600.com/ontolgies/ap600.owl> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.ap600.com/ontolgies/ap600.owl/hasBehaviour
:hasBehaviour rdf:type owl:ObjectProperty ;
              rdfs:label "hasBehaviour" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasComponent
:hasComponent rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasStructuralRelation ;
              owl:inverseOf :isComponentOf ;
              rdfs:label "hasComponent"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/hasMerealCausalityRelation
:hasMerealCausalityRelation rdf:type owl:ObjectProperty ;
                            rdfs:label "hasMerealCausalityRelation" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasProperty
:hasProperty rdf:type owl:ObjectProperty ;
             rdfs:label "hasProperty" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasStage
:hasStage rdf:type owl:ObjectProperty ;
          rdfs:label "hasStage" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasStructuralRelation
:hasStructuralRelation rdf:type owl:ObjectProperty ;
                       rdfs:label "hasStructuralRelation"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/isComponentOf
:isComponentOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasStructuralRelation ;
               rdfs:label "isComponentOf"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/isConnectedWith
:isConnectedWith rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasStructuralRelation ;
                 rdf:type owl:SymmetricProperty ;
                 rdfs:label "isConnectedWith"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/precedes
:precedes rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasMerealCausalityRelation ;
          rdf:type owl:TransitiveProperty ;
          rdfs:label "precedes" .


#################################################################
#    Data properties
#################################################################

###  http://www.ap600.com/ontolgies/ap600.owl/PowerPercentage
:PowerPercentage rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :hasPhysicalQuantity ;
                 rdfs:range xsd:string ;
                 rdfs:label "hasPowerValue"@en ,
                            "PowerPercentage" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasBoronConcetration
:hasBoronConcetration rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasPhysicalQuantity ;
                      rdfs:domain :PrimaryLoop ;
                      rdfs:comment "unit of measurement (ppm)" ;
                      rdfs:label "hasBoronConcentration" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasColdLegRupture
:hasColdLegRupture rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasSystemEventState ;
                   rdfs:domain :ColdLeg ;
                   rdfs:comment "Cold Leg state (0 = OK; 1 = Rupture)" ;
                   rdfs:label "hasColdLegRupture" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasCoolantPressure
:hasCoolantPressure rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasPhysicalQuantity ;
                    rdfs:domain :Core ;
                    rdfs:comment "unit of measurement (kPa)" ;
                    rdfs:label "hasCoolantPressure"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/hasCoreFlow
:hasCoreFlow rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hasPhysicalQuantity ;
             rdfs:domain :Core ;
             rdfs:comment "unit of measurement (kg/s)" ;
             rdfs:label "hasCoreFlow"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/hasDataInstants
:hasDataInstants rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "unit of measurement (s)" ;
                 rdfs:label "hasDataInstants" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasElectricPower
:hasElectricPower rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :PowerPercentage ;
                  rdfs:domain :ElectricGenerator ;
                  rdfs:comment "%" ;
                  rdfs:label "hasElectricPower" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasFuelAverageT
:hasFuelAverageT rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :hasPhysicalQuantity ;
                 rdfs:domain :Core ;
                 rdfs:comment "unit of measurement (°C)" ;
                 rdfs:label "hasFuelAverageT"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/hasGeneratorOutputPower
:hasGeneratorOutputPower rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf :hasPhysicalQuantity ;
                         rdfs:comment "unit of measurement (Mw)" ;
                         rdfs:label "hasOutputPower" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasNeutronPower
:hasNeutronPower rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :PowerPercentage ;
                 rdfs:domain :Core ;
                 rdfs:comment "%" ;
                 rdfs:label "hasNeutronPower"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/hasPhysicalQuantity
:hasPhysicalQuantity rdf:type owl:DatatypeProperty ;
                     rdfs:range xsd:string ;
                     rdfs:label "hasPhysicalQuantity"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/hasScramActivation
:hasScramActivation rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasSystemEventState ;
                    rdfs:domain :ScramCondition ;
                    rdfs:comment "SCRAM activation state (0 = inactive; 1 = active)" ;
                    rdfs:label "hasScramActivation" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasSpeed
:hasSpeed rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :hasPhysicalQuantity ;
          rdfs:domain :Turbine ;
          rdfs:comment "unit of measurement (RPM)" ;
          rdfs:label "hasSpeed"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/hasSystemEventState
:hasSystemEventState rdf:type owl:DatatypeProperty ;
                     rdfs:range xsd:string ;
                     rdfs:label "hasSystemEventState" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasThermalPower
:hasThermalPower rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :PowerPercentage ;
                 rdfs:domain :Core ;
                 rdfs:comment "%" ;
                 rdfs:label "hasThermalPower" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasTotalReactivity
:hasTotalReactivity rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasPhysicalQuantity ;
                    rdfs:domain :Core ;
                    rdfs:comment "unit of measurement (mk)" ;
                    rdfs:label "hasTotalReactivity" .


###  http://www.ap600.com/ontolgies/ap600.owl/hasTripActivation
:hasTripActivation rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasSystemEventState ;
                   rdfs:domain :TurbineTrip ;
                   rdfs:comment "Turbine Trip activation state (0 = inactive; 1 = active)" ;
                   rdfs:label "hasTurbineTripActivation" .


#################################################################
#    Classes
#################################################################

###  http://www.ap600.com/ontolgies/ap600.owl/ColdLeg
:ColdLeg rdf:type owl:Class ;
         rdfs:subClassOf :Leg ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isComponentOf ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :RCS
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isConnectedWith ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Vessel
                         ] ;
         rdfs:comment "That one is the class that contains all the cold legs, so those legs where there is the water flow that has just given all its heat to the water of the secondary loop. It is used to keep under control the fuel temperature."@en ;
         rdfs:label "ColdLeg"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Core
:Core rdf:type owl:Class ;
      rdfs:subClassOf :Object ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isComponentOf ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Vessel
                      ] ;
      rdfs:comment "Class that contain the core, the physical place where there is the fuel deposition and where there is the fission process. The main heat resource of our system and where almost all the thermal power is erogated."@en ;
      rdfs:label "Core"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/ElectricGenerator
:ElectricGenerator rdf:type owl:Class ;
                   rdfs:subClassOf :Object ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :isConnectedWith ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Turbine
                                   ] ;
                   rdfs:label "ElectricGenerator"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/LOCA
:LOCA rdf:type owl:Class ;
      rdfs:subClassOf :MalfunctionEvent ;
      rdfs:comment "Loss of Coolant Accident: accident due to a leakage that forces the water not to properly enter inside the core, that results in a coolant level lowering inside that component and then makes some emergency buttons to switch on. It'll result in a SCRAM."@en ;
      rdfs:label "LOCA"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Leg
:Leg rdf:type owl:Class ;
     rdfs:subClassOf :Pipe ;
     rdfs:label "Leg"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Loop
:Loop rdf:type owl:Class ;
      rdfs:subClassOf :Object ;
      rdfs:comment "That is the superclass that contains all the loops of the system."@en ;
      rdfs:label "Loop"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/MalfunctionEvent
:MalfunctionEvent rdf:type owl:Class ;
                  rdfs:subClassOf :Process ;
                  rdfs:label "MalfunctionEvent"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Object
:Object rdf:type owl:Class ;
        rdfs:label "Object"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/PWR
:PWR rdf:type owl:Class ;
     rdfs:subClassOf :Object ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasComponent ;
                       owl:allValuesFrom :PrimaryLoop
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasComponent ;
                       owl:allValuesFrom :SecondaryLoop
                     ] ;
     rdfs:comment "A class that contains all the PWR types and configurations."@en ;
     rdfs:label "PWR"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Pipe
:Pipe rdf:type owl:Class ;
      rdfs:subClassOf :Object ;
      rdfs:label "Pipe"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/PlantCondition
:PlantCondition rdf:type owl:Class ;
                rdfs:subClassOf :Process ;
                rdfs:comment "Class that rappresents different operating system conditions in a steady-state regime."@en ;
                rdfs:label "PlantCondition"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/PrimaryLoop
:PrimaryLoop rdf:type owl:Class ;
             rdfs:subClassOf :Loop ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isComponentOf ;
                               owl:allValuesFrom :PWR
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasComponent ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :RCS
                             ] ;
             rdfs:comment "Every element of this class is a primary loop, so a loop that is activated as it inglobes the Vessel and there is the recyrculation of the water that is kept in contact with the fuel rods. There are some other components whose function is to maintain the system under control."@en ;
             rdfs:label "PrimaryLoop"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Process
:Process rdf:type owl:Class ;
         rdfs:label "Process"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/RCS
:RCS rdf:type owl:Class ;
     rdfs:subClassOf :Object ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasComponent ;
                       owl:someValuesFrom :ColdLeg
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasComponent ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Vessel
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :isComponentOf ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :PrimaryLoop
                     ] ;
     rdfs:comment "A class representing the Reactor Coolant System (RCS) of a Pressurized Water Reactor (PWR). The RCS corresponds to the primary coolant circuit and includes the main components responsible for circulating pressurized water through the reactor vessel and the heat exchange sections. Its function is to remove heat from the reactor core and transfer it to the secondary system."@en ;
     rdfs:label "RCS"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/ScramCondition
:ScramCondition rdf:type owl:Class ;
                rdfs:subClassOf :PlantCondition ;
                rdfs:comment "Class that describes what happens as there is a scram, so an emergential powerig off of the system due to emergency conditions."@en ;
                rdfs:label "ScramCondition"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/SecondaryLoop
:SecondaryLoop rdf:type owl:Class ;
               rdfs:subClassOf :Loop ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :isComponentOf ;
                                 owl:allValuesFrom :PWR
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasComponent ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Turbine
                               ] ;
               rdfs:comment "That class contains secondary loops, so the secure.one found in a nuclear plant as there is no recyrculation of activated water (at least in normal-operating conditions). Its function is to garantee the electricity production, so the conversion from thermal to electric energy."@en ;
               rdfs:label "SecondaryLoop"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Turbine
:Turbine rdf:type owl:Class ;
         rdfs:subClassOf :Object ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isConnectedWith ;
                           owl:someValuesFrom :ElectricGenerator
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isComponentOf ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :SecondaryLoop
                         ] ;
         rdfs:comment "A class representing turbines in the PWR secondary system. The turbine converts the thermal energy of steam into mechanical work, which drives the electric generator and enables electricity production."@en ;
         rdfs:label "Turbine"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/TurbineTrip
:TurbineTrip rdf:type owl:Class ;
             rdfs:subClassOf :PlantCondition ;
             rdfs:label "TurbineTrip"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Vessel
:Vessel rdf:type owl:Class ;
        rdfs:subClassOf :Object ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isConnectedWith ;
                          owl:someValuesFrom :ColdLeg
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasComponent ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Core
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isComponentOf ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :RCS
                        ] ;
        rdfs:comment "A class representing the reactor vessel of a PWR. The vessel is the pressure boundary that houses the reactor core and contains the primary coolant during operation. It provides the physical environment for the core and supports the flow of coolant through the reactor to enable heat removal."@en ;
        rdfs:label "Vessel"@en .


#################################################################
#    Individuals
#################################################################

###  http://www.ap600.com/ontolgies/ap600.owl/AP600_1
:AP600_1 rdf:type owl:NamedIndividual ,
                  :PWR ;
         :hasBehaviour :LOCA1 ;
         :hasComponent :Loop1 ,
                       :SecondaryLoop1 ,
                       :electricGenerator1 ;
         :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
         :hasGeneratorOutputPower "[623; 625; 629; 629; 563; 0; 0; 0]" ;
         rdfs:comment "The values annotated with \"1\" stay for Sim1"@en ;
         rdfs:label "AP600_1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/AP600_2
:AP600_2 rdf:type owl:NamedIndividual ,
                  :PWR ;
         :hasBehaviour :LOCA2 ;
         :hasComponent :Loop2 ,
                       :SecondaryLoop2 ,
                       :electricGenerator2 ;
         :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
         :hasGeneratorOutputPower "[440; 440; 442; 439; 439; 415; 28; 0; 0]" ;
         rdfs:comment "The values with \"2\" stay for SIM2"@en ;
         rdfs:label "AP600_2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Core1
:Core1 rdf:type owl:NamedIndividual ,
                :Core ;
       :isComponentOf :Vessel1 ;
       :hasCoreFlow "[9206; 9053; 8690; 8914; 8959; 6510; 162; 229]" ;
       :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
       :hasFuelAverageT "[484; 484; 485; 453; 292; 268; 238; 264]" ;
       :hasNeutronPower "[100; 100; 100; 7; 0; 0; 0; 0]" ;
       :hasThermalPower "[100; 100; 100; 87; 8; 5; 3; 3]" ;
       :hasTotalReactivity "[0; 0; 0; -119; -197; -192; -187; -191 ]" ;
       rdfs:label "Core1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Core2
:Core2 rdf:type owl:NamedIndividual ,
                :Core ;
       :isComponentOf :Vessel2 ;
       :hasCoreFlow "[9053; 9053; 8947; 8913; 8939; 8784; 6506; 162; 200]" ;
       :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
       :hasFuelAverageT "[418; 419; 419; 418; 418; 297; 269; 235; 259]" ;
       :hasNeutronPower "[69; 69; 69; 68; 68; 0; 0; 0; 0]" ;
       :hasThermalPower "[70; 70; 70; 69; 70; 14; 5; 3; 2]" ;
       :hasTotalReactivity "[0; 0; 0; 0; 0; -195; -194; -181; -178]" ;
       rdfs:label "Core2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/LOCA1
:LOCA1 rdf:type owl:NamedIndividual ,
                :MalfunctionEvent ;
       :hasStage :SCRAM1 ,
                 :TurbineTrip1 ;
       :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
       rdfs:label "LOCA1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/LOCA2
:LOCA2 rdf:type owl:NamedIndividual ,
                :MalfunctionEvent ;
       :hasStage :SCRAM2 ,
                 :TurbineTrip2 ;
       :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
       rdfs:label "LOCA2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Loop1
:Loop1 rdf:type owl:NamedIndividual ,
                :PrimaryLoop ;
       :hasComponent :RCS1 ;
       :hasBoronConcetration "[213; 213; 213; 213; 212; 210; 199; 188]" ;
       :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
       rdfs:label "PrimaryLoop1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Loop2
:Loop2 rdf:type owl:NamedIndividual ,
                :PrimaryLoop ;
       :hasComponent :RCS2 ;
       :hasBoronConcetration "[209; 209; 209; 209; 209; 208; 203; 150; 95]" ;
       :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
       rdfs:label "PrimaryLoop2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/RCS1
:RCS1 rdf:type owl:NamedIndividual ,
               :RCS ;
      :hasComponent :Vessel1 ,
                    :coldLeg1 ;
      :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
      rdfs:label "RCS1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/RCS2
:RCS2 rdf:type owl:NamedIndividual ,
               :RCS ;
      :hasComponent :Vessel2 ,
                    :coldLeg2 ;
      :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
      rdfs:label "RCS2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/SCRAM1
:SCRAM1 rdf:type owl:NamedIndividual ,
                 :ScramCondition ;
        :precedes :TurbineTrip1 ;
        :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
        :hasScramActivation "[0; 0; 0; 1; 1; 1; 1; 1]" ;
        rdfs:label "SCRAM1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/SCRAM2
:SCRAM2 rdf:type owl:NamedIndividual ,
                 :ScramCondition ;
        :precedes :TurbineTrip2 ;
        :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
        :hasScramActivation "[0; 0; 0; 0; 0; 1; 1; 1; 1]" ;
        rdfs:label "SCRAM2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/SecondaryLoop1
:SecondaryLoop1 rdf:type owl:NamedIndividual ,
                         :SecondaryLoop ;
                :hasComponent :Turbine1 ;
                :isComponentOf :AP600_1 ;
                :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
                rdfs:label "SecondaryLoop1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/SecondaryLoop2
:SecondaryLoop2 rdf:type owl:NamedIndividual ,
                         :SecondaryLoop ;
                :hasComponent :Turbine2 ;
                :isComponentOf :AP600_2 ;
                :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
                rdfs:label "SecondaryLoop2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Turbine1
:Turbine1 rdf:type owl:NamedIndividual ,
                   :Turbine ;
          :isComponentOf :SecondaryLoop1 ;
          :isConnectedWith :electricGenerator1 ;
          :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
          :hasSpeed "[1800; 1800; 1800; 1800; 1800; 1780; 5; 5]" ;
          rdfs:label "Turbine1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Turbine2
:Turbine2 rdf:type owl:NamedIndividual ,
                   :Turbine ;
          :isComponentOf :SecondaryLoop2 ;
          :isConnectedWith :electricGenerator2 ;
          :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
          :hasSpeed "[1800; 1800; 1800; 1800; 1800; 1800; 1800; 5; 5]" ;
          rdfs:label "Turbine2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/TurbineTrip1
:TurbineTrip1 rdf:type owl:NamedIndividual ,
                       :TurbineTrip ;
              :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
              :hasTripActivation "[0; 0; 0; 0; 0; 1; 1; 1]" ;
              rdfs:label "TurbineTrip1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/TurbineTrip2
:TurbineTrip2 rdf:type owl:NamedIndividual ,
                       :TurbineTrip ;
              :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
              :hasTripActivation "[0; 0; 0; 0; 0; 0; 1; 1]" ;
              rdfs:label "TurbineTrip2"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Vessel1
:Vessel1 rdf:type owl:NamedIndividual ,
                  :Vessel ;
         :hasComponent :Core1 ;
         :isComponentOf :RCS1 ;
         :hasDataInstants "[0; 10; 20; 30; 40; 65; 185; 385]" ;
         rdfs:label "Vessel1"@en .


###  http://www.ap600.com/ontolgies/ap600.owl/Vessel2
:Vessel2 rdf:type owl:NamedIndividual ,
